# ============================================================================
# SAHARALINK — ENVIRONMENT CONFIGURATION (.env.example)
# ============================================================================
# NOTE: In Prototype Mode, SaharaLink runs 100% locally in the browser using
# LocalDemoDataService (IndexedDB + localStorage) and MockAIService.
# No external API keys are required to run or evaluate the prototype.
# ============================================================================

# Public Application URL (Used for self-referential links and callbacks)
APP_URL=""

# ----------------------------------------------------------------------------
# FUTURE PRODUCTION ADAPTERS (Supabase PostgreSQL, Auth & Storage)
# ----------------------------------------------------------------------------
# Public client-safe Supabase project URL and anonymous key (RLS enforced)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# SERVER-ONLY SECRET: Never prefix with NEXT_PUBLIC_ or expose to browser code.
# Used strictly in server-side admin routes/actions for privileged operations.
SUPABASE_SERVICE_ROLE_KEY=""

# ----------------------------------------------------------------------------
# FUTURE PRODUCTION AI ADAPTER (Server-Side OpenAIService)
# ----------------------------------------------------------------------------
# SERVER-ONLY SECRET: Never expose to client code.
OPENAI_API_KEY=""


